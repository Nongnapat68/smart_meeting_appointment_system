# Copy this file to .env and fill in real values for local development.

# --- Database (Supabase PostgreSQL) --------------------------------------
# DATABASE_URL: pooled connection (pgbouncer, port 6543) — used by the app at runtime.
# DIRECT_URL: direct connection (port 5432) — used by `prisma migrate` for schema changes.
# Get both from Supabase: Project Settings > Database > Connection string.
DATABASE_URL="postgresql://user:pass@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth (Supabase Auth) --------------------------------------------------
# Get all three from Supabase: Project Settings > API.
# NEXT_PUBLIC_SUPABASE_URL: your project's API URL.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: public key, safe to expose to the browser.
# SUPABASE_SECRET_KEY: full-privilege key — server-side only, NEVER expose to the client.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# --- AI (Anthropic / Claude) ------------------------------------------------
# Optional. Without a key the three meeting AI features (pre-meeting summary,
# pending issues, agenda suggestion) run in template mode — text assembled from
# the stored meeting data, labelled "สร้างโดยระบบ", no AI call. The AI task
# scheduling button on /tasks needs a key (it has no template mode).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# --- Email (OTP / notifications) -------------------------------------------
# Leave unset. sendEmail() (src/lib/email.ts) is still a stub: every email
# (OTP codes, invitations, reminders) is only logged to the server console —
# setting SMTP_HOST does NOT send real mail yet. Only SMTP_HOST is read today;
# the others are placeholders for a future real transport.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Smart Meeting <noreply@smartmeeting.example>"

# --- Reminder auto-processor (optional, OFF by default) -----------------------
# REMINDER_AUTO_PROCESS="1" starts a timer in the Node server (src/instrumentation.ts)
# that processes due reminders — the same thing as the admin button
# "ประมวลผล reminder ที่ถึงเวลา" on /reminders — and creates the in-app
# REMINDER notifications. Any other value (or unset) = off.
# WARNING: once on, every due reminder in the connected database is processed,
# including the reminders of the sample meetings ("ตัวอย่าง: ...").
# Only works on a long-running server (npm run dev / npm start). Serverless
# hosting keeps no process alive between requests, so it needs an external cron
# instead (POST /api/reminders/process-due currently requires an admin login
# session, so a cron-secret-protected route would have to be added for that).
REMINDER_AUTO_PROCESS="0"
# Seconds between checks (default 60, minimum 15).
REMINDER_AUTO_PROCESS_INTERVAL_SECONDS="60"

# --- Set on the command line when needed (do not keep these in .env) -------
# SEED_RESET_ALL=yes  — required by `npm run db:seed`, which DELETES ALL DATA in
#                       every table before recreating the sample data. Never run
#                       it against a shared database.
# OTP_TEST_DATABASE_URL / REMINDER_TEST_DATABASE_URL — local throwaway Postgres
#   for `npm run test:otp` / `npm run test:reminders` (localhost only), e.g.
#   postgresql://postgres:postgres@127.0.0.1:54329/otptest
