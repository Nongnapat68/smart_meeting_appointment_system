# Copy this file to .env and fill in real values for local development.

# --- Database -----------------------------------------------------------
# SQLite file for local dev. For production, point this at a PostgreSQL
# connection string instead (e.g. postgresql://user:pass@host:5432/db) and
# change the `provider` in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# --- Auth -----------------------------------------------------------------
# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-random-64-char-hex-string"

# Used only by the protected scheduler endpoint that sends due reminders.
# Generate a different long random value and set it in your deployment scheduler.
CRON_SECRET="change-me-to-a-separate-random-secret"

# --- AI (Anthropic / Claude) ------------------------------------------------
# Required for the AI pre-meeting summary and AI auto-scheduling features.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# --- Email (OTP / notifications) -------------------------------------------
# In development, leave unset — OTP codes and notification emails are logged
# to the server console instead of actually being sent (see src/lib/email.ts).
# In production, set these to enable real SMTP delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Smart Meeting <noreply@smartmeeting.example>"
