# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (ignore all real env files, but keep the committed template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma / SQLite (dev database files, in any location/state SQLite leaves them in)
*.db
*.db-journal
*.db-wal
*.db-shm

# user-uploaded files (avatars, task attachments) saved locally in dev
/public/uploads/

# Claude Code local/personal settings (not shared with the team)
/.claude/settings.local.json

# Claude Code installed skills (per-machine tool state, not app code —
# regenerated locally by the skill installer, not shared with the team)
/.claude/skills/
/.agents/
/skills-lock.json

# Throwaway one-off scripts used while running the Supabase Auth migration
# (id mapping, cleanup) — not part of the app, safe to delete once the
# migration is verified complete.
/scripts/.tmp-migration/
