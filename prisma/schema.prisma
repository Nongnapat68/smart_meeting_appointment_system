// Smart Meeting Appointment System — Prisma schema
// DB: PostgreSQL (Supabase). DATABASE_URL is the pooled (pgbouncer, port 6543) connection
// used at runtime; DIRECT_URL is the direct (port 5432) connection used for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  passwordHash          String
  name                  String
  avatarUrl             String?
  phone                 String?
  title                 String? // ตำแหน่ง
  department            String?
  role                  UserRole @default(MEMBER)
  emailNotifications    Boolean  @default(true)
  inAppNotifications    Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // A User is also represented as a Person in the contact directory so they
  // can be invited to meetings / added to groups like any other contact.
  person                Person?

  organizedMeetings     Meeting[]        @relation("MeetingOrganizer")
  assignedTasks         Task[]           @relation("TaskAssignee")
  createdTasks          Task[]           @relation("TaskCreator")
  taskComments          TaskComment[]
  notifications         Notification[]
  createdGroups         ContactGroup[]
  managedProjects       Project[]        @relation("ProjectManager")
  passwordResets        PasswordResetOtp[]
  meetingNotes          MeetingNote[]
  decisions             Decision[]
  addedResources        RelatedResource[]
  onlineMeetingResources OnlineMeetingResource[]
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// People / Contacts
// ---------------------------------------------------------------------------

enum PersonType {
  INTERNAL // linked to a User who can log in
  EXTERNAL // contact only, no login
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

model Person {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  phone        String?
  avatarUrl    String?
  title        String?
  department   String?
  type         PersonType   @default(EXTERNAL)
  status       PersonStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userId       String?      @unique
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  groupMemberships   ContactGroupMember[]
  projectMemberships ProjectMember[]
  meetingParticipations MeetingParticipant[]
  assignedTaskItems  Task[]              @relation("TaskAssigneePerson")
  organizedMeetingsAsPerson Meeting[]    @relation("MeetingOrganizerPerson")

  @@index([type])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Contact Groups
// ---------------------------------------------------------------------------

model ContactGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String   @default("group") // material symbol name
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  members     ContactGroupMember[]
  meetings    Meeting[] @relation("MeetingGroups")
  // Meetings where this group was the *source* a participant was pulled in from
  // (MeetingParticipant.sourceGroupId) — kept even if the group is later deleted
  // (see MeetingParticipant.sourceGroupId onDelete: SetNull).
  participantSources MeetingParticipant[] @relation("ParticipantSourceGroup")
}

enum GroupRole {
  LEADER // หัวหน้ากลุ่ม
  MEMBER // สมาชิก
}

model ContactGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  personId  String
  person    Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  role      GroupRole    @default(MEMBER)
  joinedAt  DateTime     @default(now())

  @@unique([groupId, personId])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  PENDING
  DELAYED
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  managerId   String?
  manager     User?         @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  members     ProjectMember[]
  meetings    Meeting[]
  tasks       Task[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([projectId, personId])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Meetings
// ---------------------------------------------------------------------------

enum MeetingType {
  SINGLE // ครั้งเดียว
  PROJECT // เชื่อมโยงกับโปรเจกต์
}

enum MeetingStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  POSTPONED
}

model Meeting {
  id          String        @id @default(cuid())
  title       String
  description String? // agenda / notes written at scheduling time (see MeetingNote for post-meeting, multi-entry notes)
  type        MeetingType   @default(SINGLE)
  status      MeetingStatus @default(PENDING)
  startTime   DateTime
  endTime     DateTime
  location    String? // physical room name, or a raw text link for meetings not using a reusable OnlineMeetingResource
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizerId String?
  organizer   User?         @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  organizerPersonId String?
  organizerPerson   Person? @relation("MeetingOrganizerPerson", fields: [organizerPersonId], references: [id], onDelete: SetNull)

  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Reusable online meeting link (FR-07/BR-09/BR-10) — nullable because a meeting
  // may instead use a physical `location`, or a one-off text link typed into it.
  onlineMeetingResourceId String?
  onlineMeetingResource   OnlineMeetingResource? @relation(fields: [onlineMeetingResourceId], references: [id], onDelete: SetNull)

  participants MeetingParticipant[]
  groups       ContactGroup[]       @relation("MeetingGroups")
  tasks        Task[]
  reminders    Reminder[]
  aiSummary    AISummary?
  notes        MeetingNote[]
  decisions    Decision[]
  resources    RelatedResource[]

  @@index([status])
  @@index([startTime])
  @@index([onlineMeetingResourceId])
}

enum ParticipantRole {
  ORGANIZER
  ATTENDEE
}

enum RsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// How a participant ended up on a meeting's invite list (BR-04) — resolved once
// at creation time by resolveParticipants() in src/app/api/meetings/route.ts and
// never recomputed later, consistent with the snapshot behavior already
// verified for BR-03.
enum ParticipantSource {
  DIRECT // picked individually in "ค้นหาบุคคล"
  GROUP // pulled in because their group was added ("เพิ่มทั้งกลุ่ม")
  EXTERNAL // added via a raw external email address
}

model MeetingParticipant {
  id         String          @id @default(cuid())
  meetingId  String
  meeting    Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  personId   String
  // Restrict (not Cascade): hard-deleting a Person who has ever attended a
  // meeting must fail loudly rather than silently erase that meeting's
  // attendance history (BR-02). See DELETE /api/people/[id] for the
  // app-level check that turns this into a friendly error, and
  // docs/DESIGN_DECISIONS.md for why this was chosen over a nullable
  // personId + name/email snapshot.
  person     Person          @relation(fields: [personId], references: [id], onDelete: Restrict)
  role       ParticipantRole @default(ATTENDEE)
  rsvpStatus RsvpStatus      @default(PENDING)
  source     ParticipantSource @default(DIRECT)
  sourceGroupId String?
  sourceGroup   ContactGroup? @relation("ParticipantSourceGroup", fields: [sourceGroupId], references: [id], onDelete: SetNull)

  @@unique([meetingId, personId])
  @@index([personId])
  @@index([sourceGroupId])
}

// ---------------------------------------------------------------------------
// Meeting context: Notes / Decisions / Related Resources (FR-11/12/13, BR-15)
// ---------------------------------------------------------------------------
// Each is a separate, multi-row entity keyed to one Meeting — replacing the old
// single `Meeting.description` field (kept only for the pre-meeting agenda) so
// a meeting can accumulate many notes, decisions and resource links over time,
// all individually traceable back to who added them and when.

model MeetingNote {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content   String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingId])
}

model Decision {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content     String
  decidedById String?
  decidedBy   User?    @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  // Traced back to a project via meeting.projectId (FR-13's "trace back to
  // project" requirement) — no separate projectId here, so a decision can
  // never point to a different project than its own meeting does.
  @@index([meetingId])
}

enum ResourceType {
  LINK
  DOCUMENT
  FILE
}

model RelatedResource {
  id        String       @id @default(cuid())
  meetingId String
  meeting   Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title     String
  url       String
  type      ResourceType @default(LINK)
  addedById String?
  addedBy   User?        @relation(fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([meetingId])
}

// ---------------------------------------------------------------------------
// Reusable Online Meeting Link (FR-07, BR-09/BR-10)
// ---------------------------------------------------------------------------
// A named link (e.g. "ทีม Marketing — Zoom Room B") that many meetings can
// point to via Meeting.onlineMeetingResourceId, instead of copy-pasting the
// same URL into `location` every time. Editing name/url here updates every
// meeting that references it in one place (BR-10); deleting it only detaches
// meetings (SetNull) rather than destroying their history.

model OnlineMeetingResource {
  id          String    @id @default(cuid())
  name        String
  url         String
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  meetings    Meeting[]

  @@index([name])
}

// ---------------------------------------------------------------------------
// Tasks / Action Items
// ---------------------------------------------------------------------------

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus   @default(NOT_STARTED)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  completedAt  DateTime?

  assigneeId       String?
  assignee         User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneePersonId String?
  assigneePerson   Person?  @relation("TaskAssigneePerson", fields: [assigneePersonId], references: [id], onDelete: SetNull)

  createdById  String?
  createdBy    User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meetingId    String?
  meeting      Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  comments     TaskComment[]
  attachments  TaskAttachment[]

  @@index([status])
  @@index([assigneeId])
  @@index([dueDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content   String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskAttachment {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  uploadedAt  DateTime @default(now())

  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Reminders
// ---------------------------------------------------------------------------

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model Reminder {
  id            String         @id @default(cuid())
  meetingId     String
  meeting       Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  status        ReminderStatus @default(PENDING)
  failureReason String?
  sentAt        DateTime?
  retryCount    Int            @default(0)
  createdAt     DateTime       @default(now())

  @@index([status])
  @@index([meetingId])
}

// ---------------------------------------------------------------------------
// Notifications (in-app)
// ---------------------------------------------------------------------------

enum NotificationType {
  MEETING_INVITE
  MEETING_UPDATED
  MEETING_CANCELLED
  TASK_ASSIGNED
  AI_SUMMARY_READY
  REMINDER
}

model Notification {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String?
  isRead      Boolean           @default(false)
  relatedId   String? // meetingId / taskId, interpreted by `type`
  createdAt   DateTime          @default(now())

  @@index([userId, isRead])
}

// ---------------------------------------------------------------------------
// AI Summaries
// ---------------------------------------------------------------------------

model AISummary {
  id          String   @id @default(cuid())
  meetingId   String   @unique
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content     String
  sources     String? // JSON-encoded array of { label, refType, refId }
  model       String
  isEdited    Boolean  @default(false)
  generatedAt DateTime @default(now())
}
